generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id        String   @id @default(cuid())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id            String         @id @default(cuid())
  roleId        String
  name          String
  email         String         @unique
  password      String
  isActive      Boolean        @default(true)
  lastLoginAt   DateTime?
  deletedAt     DateTime?
  role          Role           @relation(fields: [roleId], references: [id])
  refreshTokens RefreshToken[]
  activityLogs  AdminActivity[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([roleId])
  @@index([deletedAt])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
}

model Media {
  id          String             @id @default(cuid())
  name        String
  url         String
  publicId    String?
  mimeType    String?
  size        Int?
  altText     String?
  deletedAt   DateTime?
  productRefs ProductImage[]
  blogs       Blog[]
  categories  Category[]
  companyLogo CompanyInfo[]      @relation("CompanyLogo")
  brochures   CompanyInfo[]      @relation("CompanyBrochure")
  certs       Certification[]
  avatars     Testimonial[]
  flags       ExportCountry[]
  files       DownloadableFile[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([deletedAt])
}

model Category {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  shortDesc    String?
  description  String?
  imageId      String?
  displayOrder Int       @default(0)
  deletedAt    DateTime?
  image        Media?    @relation(fields: [imageId], references: [id])
  products     Product[]
  seo          Seo?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([slug])
  @@index([deletedAt])
}

model Product {
  id                  String         @id @default(cuid())
  categoryId          String?
  name                String
  slug                String         @unique
  shortDesc           String?
  description         String?
  richContent         Json?
  ingredients         String?
  nutritionalValues   Json?
  specifications      Json?
  sizeVariants        Json?
  packagingTypes      Json?
  sku                 String?        @unique
  exportAvailability  String?
  featured            Boolean        @default(false)
  published           Boolean        @default(true)
  deletedAt           DateTime?
  category            Category?      @relation(fields: [categoryId], references: [id])
  images              ProductImage[]
  relatedProducts     RelatedProduct[] @relation("RelatedProductSource")
  linkedFromProducts  RelatedProduct[] @relation("RelatedProductTarget")
  seo                 Seo?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([categoryId])
  @@index([slug])
  @@index([featured])
  @@index([deletedAt])
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  mediaId    String
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  product    Product  @relation(fields: [productId], references: [id])
  media      Media    @relation(fields: [mediaId], references: [id])
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([mediaId])
}

model RelatedProduct {
  id               String   @id @default(cuid())
  sourceProductId  String
  targetProductId  String
  sourceProduct    Product  @relation("RelatedProductSource", fields: [sourceProductId], references: [id])
  targetProduct    Product  @relation("RelatedProductTarget", fields: [targetProductId], references: [id])

  @@unique([sourceProductId, targetProductId])
}

model Blog {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String?
  coverImageId String?
  published   Boolean   @default(true)
  publishedAt DateTime?
  deletedAt   DateTime?
  coverImage  Media?    @relation(fields: [coverImageId], references: [id])
  seo         Seo?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([deletedAt])
}

model Testimonial {
  id          String    @id @default(cuid())
  name        String
  title       String?
  company     String?
  quote       String
  rating      Int       @default(5)
  avatarId    String?
  displayOrder Int      @default(0)
  deletedAt   DateTime?
  avatar      Media?    @relation(fields: [avatarId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deletedAt])
}

model Faq {
  id           String    @id @default(cuid())
  question     String
  answer       String
  displayOrder Int       @default(0)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([deletedAt])
}

model Certification {
  id           String    @id @default(cuid())
  title        String
  description  String?
  logoId       String?
  displayOrder Int       @default(0)
  deletedAt    DateTime?
  logo         Media?    @relation(fields: [logoId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([deletedAt])
}

model ExportCountry {
  id             String    @id @default(cuid())
  name           String
  code           String
  description    String?
  flagMediaId    String?
  displayOrder   Int       @default(0)
  deletedAt      DateTime?
  flagMedia      Media?    @relation(fields: [flagMediaId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([code])
  @@index([deletedAt])
}

model Inquiry {
  id             String    @id @default(cuid())
  type           String
  name           String
  company        String?
  email          String
  phone          String?
  country        String?
  message        String
  status         String    @default("NEW")
  notes          String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([type, status])
  @@index([deletedAt])
}

model WebsiteSetting {
  id         String   @id @default(cuid())
  key        String   @unique
  value      Json
  deletedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([deletedAt])
}

model CompanyInfo {
  id            String   @id @default(cuid())
  companyName   String
  tagline       String?
  description   String?
  address       String?
  phone         String?
  email         String?
  whatsapp      String?
  googleMapUrl  String?
  brochureId    String?
  logoId        String?
  foundedYear   String?
  deletedAt     DateTime?
  logo          Media?   @relation("CompanyLogo", fields: [logoId], references: [id])
  brochure      Media?   @relation("CompanyBrochure", fields: [brochureId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([deletedAt])
}

model SocialLink {
  id           String   @id @default(cuid())
  platform     String
  label        String
  url          String
  displayOrder Int      @default(0)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([deletedAt])
}

model Menu {
  id          String     @id @default(cuid())
  name        String
  location    String
  deletedAt   DateTime?
  items       MenuItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([location])
  @@index([deletedAt])
}

model MenuItem {
  id        String   @id @default(cuid())
  menuId    String
  label     String
  href      String
  order     Int      @default(0)
  target    String?
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([menuId])
}

model Page {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  summary     String?
  template    String?
  published   Boolean       @default(true)
  deletedAt   DateTime?
  sections    PageSection[]
  seo         Seo?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([slug])
  @@index([deletedAt])
}

model PageSection {
  id         String   @id @default(cuid())
  pageId     String
  name       String
  sectionKey String
  order      Int      @default(0)
  content    Json
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([pageId])
}

model Seo {
  id               String    @id @default(cuid())
  metaTitle        String?
  metaDescription  String?
  ogTitle          String?
  ogDescription    String?
  ogImage          String?
  keywords         String?
  canonicalUrl     String?
  productId        String?   @unique
  categoryId       String?   @unique
  blogId           String?   @unique
  pageId           String?   @unique
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  product          Product?  @relation(fields: [productId], references: [id])
  category         Category? @relation(fields: [categoryId], references: [id])
  blog             Blog?     @relation(fields: [blogId], references: [id])
  page             Page?     @relation(fields: [pageId], references: [id])
}

model DownloadableFile {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  mediaId     String
  kind        String
  deletedAt   DateTime?
  media       Media     @relation(fields: [mediaId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deletedAt])
}

model AdminActivity {
  id         String   @id @default(cuid())
  userId     String
  action     String
  resource   String
  meta       Json?
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@index([userId, resource])
}
